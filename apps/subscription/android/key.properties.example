# 릴리스 서명 키 설정 템플릿. 복사해서 android/key.properties 로 만들고 값 채우기.
#   cp key.properties.example key.properties
# key.properties 는 .gitignore 로 커밋되지 않는다.
# storeFile: 키스토어(.jks) 경로. dday와 같은 키를 재사용해도 되고(예: ~/keys/dday-upload.jks),
#            앱별로 새로 만들어도 된다(권장).
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=/Users/parksungho/keys/subscription-upload.jks
